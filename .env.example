# 复制成 .env 再按机器改；install.sh 会自动生成并补全路径。这个文件不进镜像。
#
# 注意：值后面不要写行内注释 —— 注释会被当成值的一部分。
# 全新环境正常不用改这个文件：跑 bash install.sh（一键）或 bash install.sh --custom（向导），
# 它会体检机器、问你要什么、把这里填好。

# 1) QQ 怎么接：napcat=自带你自己的协议端容器 / reuse=复用本机已有的 / none=先不接
#    选 reuse 或 none 时不用填 QQ_ACCOUNT，也不会拉 NapCat 镜像。
QQ_ONEBOT_MODE=napcat
# 1b) 登录用的账号（mode=napcat 时必填，没有任何默认值；reuse/none 可留空）
QQ_ACCOUNT=
TZ=Asia/Shanghai

# 2) 镜像 tag / 版本号（跟桥接版本走，不要只用 latest）
QQ_TAG=v0.7.4

# 3) 跑容器的用户（install.sh 会填当前用户的 uid/gid，避免数据卷里出现 root 属主的文件）
QQ_UID=
QQ_GID=

# 3b) docker 属组：/var/run/docker.sock 的组号（install.sh 自动探测并写入）
#     有了它，容器里直接能用 docker（控制台状态台、开发模式构建镜像）。
QQ_DOCKER_GID=

# 4) 宿主路径（install.sh 会按当前用户 HOME 生成；也可以自己指定）
#    数据根：会话/日志/状态/配置/媒体
QQ_DATA_ROOT=
#    DSH home：profile、插件、凭据
QQ_DSH_HOME=
#    工作区：DSH 会话落地的目录，**必须可写**（install.sh 会实测）
QQ_WORKSPACE=
#    工作区根：整棵按原路径挂进容器且可写，决定控制台「系统配置」里能把工作区绑到哪个范围。
#    默认 = QQ_WORKSPACE 的父目录。想更严就填成和 QQ_WORKSPACE 一样；
#    想更自由（比如绑到自己已有的项目目录）就填 $HOME。
QQ_WORKSPACE_ROOT=
#    QQ 登录态（换机器要带上，否则要重扫）
QQ_NAPCAT_DATA=
QQ_NAPCAT_CONFIG=
QQ_NAPCAT_CACHE=
#    宿主级环境变量文件（可选，不存在也能起）
QQ_ENV_FILE=./dsh.env

# 5) 网络
#    DSH WebUI 端口（不占 3080，方便和你自己跑的 dsh 共存）
QQ_DSH_PORT=3081
#    控制台端口
QQ_CONSOLE_PORT=8798
#    上游代理（可空 = 直连；由 entrypoint 探活决定用不用）
UPSTREAM_PROXY=
PROXY_PROBE_URL=https://api.deepseek.com

# 6) 镜像：默认用预构建镜像（公开可拉，免登录）
QQ_HARNESS_IMAGE=crpi-nqwu6u57qjindq7p.cn-hangzhou.personal.cr.aliyuncs.com/zfqxuz/qqbot-harness:v0.7.4
QQ_CONSOLE_IMAGE=crpi-nqwu6u57qjindq7p.cn-hangzhou.personal.cr.aliyuncs.com/zfqxuz/qqbot-console:v0.7.4
QQ_NAPCAT_IMAGE=docker.m.daocloud.io/mlikiowa/napcat-docker:latest
# 想用自己构建的镜像：把上面两项改成 qqbot-harness:${QQ_TAG} / qqbot-console:${QQ_TAG}，
# 然后在本目录跑 ./build.sh（需要两个源码仓库）
# 构建期下载源（墙内可换成镜像/代理前缀；默认官方）
QQ_NPM_REGISTRY=https://registry.npmjs.org
QQ_GH_DOWNLOAD_BASE=https://github.com
# 下面三项只有本地构建镜像时才需要：
QQ_BRIDGE_REPO=
QQ_PLUGINS_REPO=
QQ_REPOS_ROOT=
# 往镜像仓库推送时用（./build.sh --push）
QQ_REGISTRY=crpi-nqwu6u57qjindq7p.cn-hangzhou.personal.cr.aliyuncs.com
QQ_NAMESPACE=zfqxuz

# 6.5) 会话托管权（可选，v0.7.3 起）：宿主 dsh 与容器共用一份 DSH home 时谁在写
#      auto（默认）= 看心跳名册选主：宿主/桌面端在跑时容器待机，对方退出后自动接管；
#      container-only = 无视宿主，容器一直跑（两个 harness 同时写时靠桥的冲突排队兜底）；
#      off = 逃生开关：跳过 supervisor，按老行为直接起 harness。
# QQ_HARNESS_MODE=auto
# T1：名册连续为空多久才接管（默认 90 秒，短了会在开机窗口抢跑）；T2：宿主回来确认多久才交回
# QQ_TAKEOVER_T1_SECONDS=90
# QQ_TAKEOVER_T2_SECONDS=30
# QQ_MIN_HOLD_SECONDS=120      # 交回后多久内不再抢
# QQ_SWITCHES_PER_HOUR=3       # 一小时切换上限，超了停在待机并告警

# 7) 开发者模式（可选）：源码可写挂载 + docker 控制权
#    跑 install.sh --dev 会写入这个开关；正式部署不要开。
QQ_DEV_MOUNT=
