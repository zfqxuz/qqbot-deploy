# 复制成 .env 再按机器改；install.sh 会自动生成并补全路径。这个文件不进镜像。
#
# 注意：值后面不要写行内注释 —— 注释会被当成值的一部分。
# 全新环境只需要改一项：QQ_ACCOUNT（登录用的 QQ 号），其余 install.sh 会按当前用户生成。

# 1) QQ：登录用的账号（必填，没有任何默认值）
QQ_ACCOUNT=
TZ=Asia/Shanghai

# 2) 镜像 tag / 版本号（跟桥接版本走，不要只用 latest）
QQ_TAG=v0.7.0

# 3) 跑容器的用户（install.sh 会填当前用户的 uid/gid，避免数据卷里出现 root 属主的文件）
QQ_UID=
QQ_GID=

# 4) 宿主路径（install.sh 会按当前用户 HOME 生成；也可以自己指定）
#    数据根：会话/日志/状态/配置/媒体
QQ_DATA_ROOT=
#    DSH home：profile、插件、凭据
QQ_DSH_HOME=
#    工作区：你在里面写代码/建会话；首启为空，重建容器不动它
QQ_WORKSPACE=
#    QQ 登录态（换机器要带上，否则要重扫）
QQ_NAPCAT_DATA=
QQ_NAPCAT_CONFIG=
QQ_NAPCAT_CACHE=
#    宿主级环境变量文件（可选，不存在也能起）
QQ_ENV_FILE=./dsh.env

# 5) 网络
#    DSH WebUI 端口（不占 3080，方便和你自己跑的 dsh 共存）
QQ_DSH_PORT=3081
#    控制台端口
QQ_CONSOLE_PORT=8798
#    上游代理（可空 = 直连；由 entrypoint 探活决定用不用）
UPSTREAM_PROXY=
PROXY_PROBE_URL=https://api.deepseek.com

# 6) 镜像：默认用预构建镜像（公开可拉，免登录）
QQ_HARNESS_IMAGE=crpi-nqwu6u57qjindq7p.cn-hangzhou.personal.cr.aliyuncs.com/zfqxuz/qqbot-harness:v0.7.0
QQ_CONSOLE_IMAGE=crpi-nqwu6u57qjindq7p.cn-hangzhou.personal.cr.aliyuncs.com/zfqxuz/qqbot-console:v0.7.0
QQ_NAPCAT_IMAGE=docker.m.daocloud.io/mlikiowa/napcat-docker:latest
# 想用自己构建的镜像：把上面两项改成 qqbot-harness:${QQ_TAG} / qqbot-console:${QQ_TAG}，
# 然后在本目录跑 ./build.sh（需要两个源码仓库）
# 下面三项只有本地构建镜像时才需要：
QQ_BRIDGE_REPO=
QQ_PLUGINS_REPO=
QQ_REPOS_ROOT=
# 往镜像仓库推送时用（./build.sh --push）
QQ_REGISTRY=crpi-nqwu6u57qjindq7p.cn-hangzhou.personal.cr.aliyuncs.com
QQ_NAMESPACE=zfqxuz
